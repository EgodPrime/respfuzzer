[llm]
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxx" # your OpenAI API key
# 稿件使用的最终模型（三模型之一，复现实验时按需替换）:
#   - Llama3.1-8B-Instruct   (Llama-3.1-8B-Instruct / Llama-3.1-8B)
#   - Qwen3.6-35B-A3B        (默认，本模板采用)
#   - gpt-oss-120b
# 复现多个模型时请分别替换 model_name 并记录 checkpoint 版本（见 E-20）。
model_name = "Qwen3.6-35B-A3B"
temperature = 0.7

[redis]
host = "127.0.0.1"
port = 6379
db = 0

[fuzz]
execution_timeout = 5.0
deterministic_mode = true
llm_fuzz_per_seed = 10
data_fuzz_per_seed = 10
max_try_per_seed = 10
max_workers = 50

[llm_mutator]
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxx" # your OpenAI API key
model_name = "Qwen3.6-35B-A3B"
temperature = 0.7

[reflective_seeder]
concurrency = 4 # number of threads for seeding
use_reasoner = true
use_docs = true

[fuzz4all]
strategy = 1
concurrency = 10
execution_timeout = 5.0
llm_fuzz_per_seed = 100