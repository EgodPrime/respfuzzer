[llm]
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxx" # your OpenAI API key
model_name = "Qwen3.6-35B-A3B" # one of [Llama-3.1-8B-Instruct, Qwen3.6-35B-A3B, gpt-oss-120b]
temperature = 0.7

[redis]
host = "127.0.0.1"
port = 6379
db = 0

[fuzz]
execution_timeout = 5.0
deterministic_mode = true
llm_fuzz_per_seed = 10
data_fuzz_per_seed = 10
max_try_per_seed = 10
max_workers = 10
# 预算模式: llm_calls (固定LLM调用次数,默认) / wall_clock (固定运行时间秒) / executions (固定实际执行次数)
budget_mode = "llm_calls"
# 预算值,默认使用 llm_fuzz_per_seed
# budget_value = 10

[llm_mutator]
base_url = "https://api.openai.com/v1"
api_key = "sk-xxxxxxx" # your OpenAI API key
model_name = "Qwen3.6-35B-A3B" # one of [Llama-3.1-8B-Instruct, Qwen3.6-35B-A3B, gpt-oss-120b]
temperature = 0.7

[reflective_seeder]
concurrency = 4 # number of threads for seeding
budget=10
use_reasoner = true
use_docs = true
mode = "respfuzzer" # ["respfuzzer", "respfuzzer-wodoc", "respfuzzer-wofb", "respfuzzer-woboth", "rag"]

[fuzz4all]
strategy = 1
concurrency = 10
execution_timeout = 5.0
llm_fuzz_per_seed = 100
# 预算由命令行控制: -lrequest N (单函数 LLM 请求批次数上限) / -ltime S (单函数总变异时间,秒)
# 两者同时生效、先耗尽者停; 都不指定时回退 llm_fuzz_per_seed

[dyfuzz]
# 预算由命令行控制: -lmutant N (单种子变异次数上限) / -ltime S (单种子总测试时间,秒)
# 两者同时生效、先耗尽者停; 至少传一个, 都不传时报错退出(无 config 兜底)
# RQ1 的 RAG 基线【MC6-2】：检索用 embedding 服务（OpenAI 兼容 /v1/embeddings）。
# 不配置（或整段注释）时：开发/测试用确定性 fake embedding；正式跑 rq1seed --mode rag
# --no-fake-embedding 会在未配置时显式报错，不静默降级。
# 可用 `python -m respfuzzer.lib.rq1.embedding_mock --port 8123` 起本地 mock 服务。
#[embedding]
#base_url = "http://127.0.0.1:8123/v1"
#api_key = "sk-mock"
#model_name = "mock-embedding"
#batch_size = 64
